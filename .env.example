# AWS Textract Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_REPORT_BUCKET=your_s3_bucket_name

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
OPENAI_API_KEY=open_ai_key_here

# MongoDB Prompt Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/onehealth_ai_beta
MONGO_DB_NAME=
MONGO_USECASES_COLLECTION=usecases
MONGO_USERS_COLLECTION=users
MONGO_CREATE_REPORT_ANALYSIS_COLLECTION=createReportAnalysisSettings
MONGO_TRANSCRIPT_CHUNKS_COLLECTION=transcriptchunks
MONGO_USER_REPORT_TYPES_COLLECTION=userreporttypes
MONGO_USER_PRESCRIPTIONS_COLLECTION=userprescriptions
REQUIRE_MONGO_PROMPTS=false
